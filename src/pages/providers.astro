---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ProvidersPage } from '../views/ProvidersPage';
import { getServices, type PublicService } from '../lib/api';

let services: PublicService[] = [];
let registryAvailable = true;
try {
  services = (await getServices()).services;
} catch {
  registryAvailable = false;
}
---
<BaseLayout
  title="For Providers · Daski"
  description="List your service on Daski. Implement A2A, receive USDC settlements, and get paid by any AI agent on the protocol."
>
  <ProvidersPage services={services} registryAvailable={registryAvailable} />
</BaseLayout>
