---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ActivityPage } from '../views/ActivityPage';
import { getRailMetadata, type StandardRailMetadata } from '../lib/api';

let initialMetadata: StandardRailMetadata | null = null;
try {
  initialMetadata = await getRailMetadata();
} catch {
  initialMetadata = null;
}
---
<BaseLayout
  title="Rail status · Daski"
  description="The active Daski standard x402 rail and immutable Testnet outcome splitters."
>
  <ActivityPage client:load initialMetadata={initialMetadata} />
</BaseLayout>
