---
import BaseLayout from '../layouts/BaseLayout.astro';

const assets = [
  { title: 'Logo', background: 'light', file: 'daski-logo-light', wide: true },
  { title: 'Logo', background: 'dark', file: 'daski-logo-dark', wide: true },
  { title: 'Letter mark', background: 'light', file: 'daski-mark-light', wide: false },
  { title: 'Letter mark', background: 'dark', file: 'daski-mark-dark', wide: false },
];

const colors = [
  { name: 'Ink', hex: '#0a0a0f' },
  { name: 'White', hex: '#ffffff' },
  { name: 'Mint (on dark)', hex: '#34d3b1' },
  { name: 'Mint (on light)', hex: '#1cba99' },
];
---
<BaseLayout
  title="Brand Assets · Daski"
  description="Download Daski logos and letter marks in SVG and transparent PNG formats for press, partners and integrations."
>
  <main class="brand-page">
    <header class="brand-hero">
      <p class="brand-caption">Brand assets</p>
      <h1>Brand Assets</h1>
      <p class="brand-intro">
        Logos for press, partners and integrations. SVGs are outlined vectors; PNGs have transparent backgrounds.
      </p>
    </header>

    <section class="brand-grid" aria-label="Logo downloads">
      {assets.map((asset) => (
        <article class="dk-card brand-card">
          <div class:list={['brand-preview', `brand-preview--${asset.background}`]}>
            <img
              src={`/assets/brand/${asset.file}.svg`}
              alt={`Daski ${asset.title.toLowerCase()}, for ${asset.background} backgrounds`}
              class:list={{ 'brand-logo': asset.wide }}
              width={asset.wide ? 2400 : 1024}
              height={asset.wide ? 842 : 1024}
            />
          </div>
          <div class="brand-card-details">
            <div class="brand-card-label">
              <h2>{asset.title}</h2>
              <p>For {asset.background} backgrounds</p>
            </div>
            <div class="brand-downloads">
              {['svg', 'png'].map((format) => (
                <a
                  href={`/assets/brand/${asset.file}.${format}`}
                  download={`${asset.file}.${format}`}
                  aria-label={`Download Daski ${asset.title.toLowerCase()} for ${asset.background} backgrounds (${format.toUpperCase()})`}
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3v12m-5-5 5 5 5-5M5 16v4h14v-4" />
                  </svg>
                  {format.toUpperCase()}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="brand-colors" aria-labelledby="brand-colors-heading">
      <h2 id="brand-colors-heading" class="brand-caption">Colors</h2>
      <div class="brand-color-grid">
        {colors.map((color) => (
          <div class="dk-card brand-color">
            <span class="brand-swatch" style={{ background: color.hex }} aria-hidden="true" />
            <div>
              <h3>{color.name}</h3>
              <p>{color.hex}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .brand-page { max-width: 1280px; margin: 0 auto; padding: 88px 32px 0; }
  .brand-hero { max-width: 880px; margin-bottom: 40px; }
  .brand-caption { margin: 0 0 18px; color: var(--pro-text-dim); font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0; color: var(--pro-text); font-size: 56px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.04; }
  .brand-intro { max-width: 640px; margin: 22px 0 0; color: var(--pro-text-dim); font-size: 17px; line-height: 1.6; }
  .brand-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .brand-card { padding: 0; overflow: hidden; }
  .brand-preview { height: 220px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--pro-border); padding: 32px; }
  .brand-preview--light { background: #ffffff; }
  .brand-preview--dark { background: #0a0a0f; }
  .brand-preview img { width: 96px; height: 96px; max-width: 100%; object-fit: contain; }
  .brand-preview .brand-logo { width: auto; height: 72px; }
  .brand-card-details { padding: 16px 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .brand-card-label { flex: 1; min-width: 140px; }
  .brand-card-label h2 { margin: 0; color: var(--pro-text); font-size: 15px; font-weight: 600; }
  .brand-card-label p { margin: 2px 0 0; color: var(--pro-text-dim); font-size: 13px; }
  .brand-downloads { display: flex; gap: 8px; }
  .brand-downloads a { display: inline-flex; align-items: center; gap: 7px; min-height: 30px; padding: 0 12px; border-radius: 7px; border: 1px solid var(--pro-border); background: var(--pro-surface); color: var(--pro-text); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; font-weight: 500; text-decoration: none; }
  .brand-downloads a:hover { border-color: var(--mint-400); }
  .brand-colors { margin-top: 56px; }
  .brand-colors .brand-caption { margin-bottom: 14px; }
  .brand-color-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
  .brand-color { padding: 14px; display: flex; align-items: center; gap: 12px; }
  .brand-swatch { width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--pro-border); flex-shrink: 0; }
  .brand-color h3 { margin: 0; color: var(--pro-text); font-size: 14px; font-weight: 500; }
  .brand-color p { margin: 2px 0 0; color: var(--pro-text-dim); font-size: 12px; font-family: var(--font-mono); }
  @media (max-width: 820px) {
    .brand-page { padding: 64px 20px 0; }
    h1 { font-size: 38px; line-height: 1.06; }
  }
  @media (max-width: 720px) { .brand-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { h1 { font-size: 30px; } }
</style>
