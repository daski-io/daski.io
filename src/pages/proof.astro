---
import BaseLayout from '../layouts/BaseLayout.astro';

// Unlinked marketing page: evidence that Daski registered its own entity
// through Daski rails. Update the filing fields once the state records it.
const proof = {
  youtubeId: 'He00M2mktvM',
  entityName: 'Daski',
  chainName: 'Base',
  txHash: '0xa6b8402239892ba7f2c87779b3053595e0ce2c78a04e98d8682a38d5bcb94217',
  block: 51877982,
  fileNumber: 'Pending',
  filedAt: 'Pending',
  filingUrl: null as string | null,
};

const explorerTxUrl = `https://basescan.org/tx/${proof.txHash}`;
const shortHash = `${proof.txHash.slice(0, 10)}…${proof.txHash.slice(-8)}`;

const cards = [
  {
    kicker: `onchain · ${proof.chainName.toLowerCase()}`,
    title: 'Settlement transaction',
    meta: [['Tx', shortHash], ['Block', proof.block.toLocaleString('en-US')], ['Network', proof.chainName]],
    href: explorerTxUrl,
    cta: 'View on Basescan',
  },
  {
    kicker: 'state filing',
    title: proof.entityName,
    meta: [['File no.', proof.fileNumber], ['Filed', proof.filedAt]],
    href: proof.filingUrl,
    cta: proof.filingUrl ? 'View filing document' : 'Filing document pending',
  },
];
---
<BaseLayout
  title="Proof · Daski"
  description="Daski registered its own entity through the Daski marketplace. Watch the recording and verify the settlement transaction on Base."
>
  <main class="proof-page">
    <header class="proof-hero">
      <p class="proof-caption">proof · entity registration</p>
      <h1>Daski registered itself, on Daski.</h1>
      <p class="proof-intro">
        An agent bought {proof.entityName}'s state registration through the Daski marketplace. Payment settled on {proof.chainName} and the filing was fulfilled by a listed provider. The recording, the transaction and the filing are below.
      </p>
    </header>

    <section class="dk-card proof-video" aria-label="Registration recording">
      <div class="proof-video-frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${proof.youtubeId}?rel=0`}
          title="Daski entity registration"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </section>

    <section class="proof-grid" aria-label="Registration records">
      {cards.map((card) => {
        const Tag = card.href ? 'a' : 'div';
        return (
          <Tag
            class:list={['dk-card', 'proof-card', { 'proof-card--link': card.href }]}
            {...(card.href ? { href: card.href, target: '_blank', rel: 'noreferrer' } : {})}
          >
            <p class="proof-caption">{card.kicker}</p>
            <h2>{card.title}</h2>
            <dl>
              {card.meta.map(([label, value]) => (
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              ))}
            </dl>
            <span class:list={['proof-cta', { 'proof-cta--pending': !card.href }]}>
              {card.cta}
              {card.href && (
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 4h6v6" /><path d="M20 4 10 14" /><path d="M20 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4" />
                </svg>
              )}
            </span>
          </Tag>
        );
      })}
    </section>
  </main>
</BaseLayout>

<style>
  .proof-page { max-width: 1280px; margin: 0 auto; padding: 88px 32px 96px; }
  .proof-hero { max-width: 820px; margin-bottom: 40px; }
  .proof-caption { margin: 0 0 18px; color: var(--pro-text-dim); font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0; color: var(--pro-text); font-size: 56px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.04; text-wrap: balance; }
  .proof-intro { max-width: 640px; margin: 22px 0 0; color: var(--pro-text-dim); font-size: 17px; line-height: 1.6; text-wrap: pretty; }
  .proof-video { padding: 0; overflow: hidden; margin-bottom: 24px; }
  .proof-video-frame { position: relative; aspect-ratio: 16 / 9; background: #000; }
  .proof-video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .proof-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .proof-card { padding: 24px 24px 22px; display: flex; flex-direction: column; gap: 14px; color: inherit; text-decoration: none; transition: border-color 160ms var(--ease); }
  .proof-card .proof-caption { margin: 0; }
  .proof-card--link:hover { border-color: var(--mint-400); }
  .proof-card h2 { margin: 0; color: var(--pro-text); font-size: 20px; font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; }
  .proof-card dl { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 16px; row-gap: 6px; }
  .proof-card dt { color: var(--pro-text-dim); font-size: 13px; }
  .proof-card dd { margin: 0; color: var(--pro-text); font-size: 13px; font-family: var(--font-mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .proof-cta { margin-top: auto; padding-top: 6px; color: var(--mint-400); font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px; }
  .proof-cta--pending { color: var(--pro-text-dim); }
  @media (max-width: 820px) {
    .proof-page { padding: 64px 20px 72px; }
    h1 { font-size: 38px; line-height: 1.06; }
  }
  @media (max-width: 720px) { .proof-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { h1 { font-size: 30px; } }
</style>
