---
import TermsContent, { getHeadings } from '../content/legal/terms-of-use.md';
import LegalLayout from '../layouts/LegalLayout.astro';
import { PAGE_METADATA } from '../lib/seo';

const headings = getHeadings();
---
<LegalLayout
  title="Daski Terms of Use"
  metadataTitle={PAGE_METADATA['/terms-of-use'].title}
  description={PAGE_METADATA['/terms-of-use'].description}
  canonicalUrl="https://daski.io/terms-of-use"
  kicker="terms of use"
  version="1.0"
  effectiveDate="July 14, 2026"
  roleLabel="Marketplace operator"
  roleValue={'Daski, a Wyoming corporation ("Daski," "we," "us," or "our")'}
  headings={headings}
  nextLabel="Privacy Policy"
  nextHref="/privacy-policy"
>
  <TermsContent />
</LegalLayout>
