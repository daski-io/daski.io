---
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { siteName, siteTitle } from '../lib/chains';
import { networkConfig, networkView } from '../lib/network';
import { canonicalPageUrl, descriptionExcerpt, homeDescription, pageTitle, SOCIAL_IMAGE } from '../lib/seo';
import '../styles/app.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

// The instance's network is resolved once on the server; islands receive the
// serializable view as props and never read the environment themselves.
const network = networkConfig();
const view = networkView(network);
const pathname = Astro.url.pathname;

const {
  title: pageHeading,
  description: pageDescription = homeDescription(network),
  canonicalUrl = canonicalPageUrl(pathname, network.siteUrl),
  noindex = false,
} = Astro.props;
const title = pageHeading ? pageTitle(pageHeading, network) : siteTitle(view);
const description = descriptionExcerpt(pageDescription);
const imageUrl = new URL(SOCIAL_IMAGE.path, network.siteUrl).href;
const robots = noindex || network.robots === 'noindex'
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large';
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName(view),
  url: canonicalPageUrl('/', network.siteUrl),
  description: homeDescription(network),
  inLanguage: 'en',
};

---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName(view)} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SOCIAL_IMAGE.width)} />
    <meta property="og:image:height" content={String(SOCIAL_IMAGE.height)} />
    <meta property="og:image:alt" content={SOCIAL_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE.alt} />
    {pathname === '/' && <script is:inline type="application/ld+json" set:html={JSON.stringify(website).replace(/</g, '\\u003c')} />}
  </head>
  <body data-theme="dark">
    <div style="min-height: 100vh; background: var(--pro-bg);">
      <Header client:load pathname={pathname} network={view} />
      <slot />
      <Footer network={view} />
    </div>
  </body>
</html>
