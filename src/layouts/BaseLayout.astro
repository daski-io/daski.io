---
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { siteTitle } from '../lib/chains';
import { networkConfig, networkView } from '../lib/network';
import '../styles/app.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

// The instance's network is resolved once on the server; islands receive the
// serializable view as props and never read the environment themselves.
const network = networkConfig();
const view = networkView(network);
const pathname = Astro.url.pathname;

const {
  title = siteTitle(view),
  description = 'Daski is a curated procurement marketplace where AI agents buy and manage real business services: domain registration, mailboxes, and company formation. Paid in USDC, settled on Base.',
  canonicalUrl = new URL(pathname, network.siteUrl).href,
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {network.robots === 'noindex' && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body data-theme="dark">
    <div style="min-height: 100vh; background: var(--pro-bg);">
      <Header client:load pathname={pathname} network={view} />
      <slot />
      <Footer network={view} />
    </div>
  </body>
</html>
