# Daski website instance configuration. Every value has a default: a service
# with none of these set is the Testnet sandbox site. Read once at startup by
# src/lib/network.ts; islands receive the resolved values as props.

# Which network this instance serves: testnet | mainnet
DASKI_NETWORK=testnet

# Public gateway origin used by the server and the browser. Defaults to the
# sandbox gateway on testnet. Leave unset on mainnet until the mainnet gateway
# exists: the site then renders its empty states and the launching-soon strip.
GATEWAY_URL=https://sandbox-gateway.daski.io

# Optional server-only origin over Railway private networking. Ignored when no
# public gateway is configured.
GATEWAY_INTERNAL_URL=

# Strip under the header: testnet | mainnet-soon | none. Derived when unset:
# testnet on testnet, mainnet-soon on mainnet without a gateway, none otherwise.
NETWORK_NOTICE=

# This instance's canonical origin. Defaults to the network's public host.
SITE_URL=

# Header switch targets for each network.
TESTNET_SITE_URL=https://sandbox.daski.io
MAINNET_SITE_URL=https://daski.io

# Block explorer origin. Defaults to Basescan for the configured chain.
EXPLORER_URL=

# index | noindex. Set noindex on the sandbox instance once mainnet is live.
SITE_ROBOTS=
